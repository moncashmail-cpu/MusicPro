# App Environment
NODE_ENV=development
ENVIRONMENT=development

# Database (PostgreSQL)
POSTGRES_USER=musikpro
POSTGRES_PASSWORD=musikpro_secret
POSTGRES_DB=musikpro_db
DATABASE_URL=postgresql+asyncpg://musikpro:musikpro_secret@localhost:5432/musikpro_db
SYNC_DATABASE_URL=postgresql://musikpro:musikpro_secret@localhost:5432/musikpro_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=musikpro-media
S3_REGION=us-east-1

# API & Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
JWT_SECRET=super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SoundFonts Path
SOUNDFONT_PATH=./packages/audio-synth/soundfonts/FluidR3_GM.sf2
